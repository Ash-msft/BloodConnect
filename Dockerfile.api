# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for the BloodConnect ASP.NET Core API.
# Build context must be the repository root (see docker-compose.yml).

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY BloodConnect.slnx ./
COPY src/BloodConnect.Domain/BloodConnect.Domain.csproj src/BloodConnect.Domain/
COPY src/BloodConnect.Infrastructure/BloodConnect.Infrastructure.csproj src/BloodConnect.Infrastructure/
COPY src/BloodConnect.Api/BloodConnect.Api.csproj src/BloodConnect.Api/
COPY tests/BloodConnect.Tests/BloodConnect.Tests.csproj tests/BloodConnect.Tests/
RUN dotnet restore src/BloodConnect.Api/BloodConnect.Api.csproj

COPY src/ src/
COPY tests/ tests/
RUN dotnet publish src/BloodConnect.Api/BloodConnect.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Persist the SQLite database file outside the container filesystem layer.
RUN mkdir -p /data
VOLUME ["/data"]

ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    ConnectionStrings__Default="Data Source=/data/bloodconnect.db"

COPY --from=build /app/publish .

EXPOSE 8080
ENTRYPOINT ["dotnet", "BloodConnect.Api.dll"]
