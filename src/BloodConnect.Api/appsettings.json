{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=bloodconnect.db"
  },
  "BloodConnect": {
    "MinimumDonationIntervalDays": 56,
    "RequestExpiryHours": 72,
    "MaxDonorsNotifiedPerRequest": 50,
    "Teams": {
      "Enabled": false,
      "IncomingWebhookUrl": "",
      "AppBaseUrl": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
